# Copy to .env.local for local overrides. These values are public and bundled
# into the site; never put a secret in a NEXT_PUBLIC_* variable.

# Canonical production URL, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://votre-domaine.fr

# Public URL of the Google Form used by all booking calls to action.
NEXT_PUBLIC_BOOKING_URL=https://forms.gle/REMPLACEZ_MOI

# Public contact details displayed on the legal page.
NEXT_PUBLIC_CONTACT_EMAIL=infos@studio-seo.fr
NEXT_PUBLIC_LEGAL_NAME=À compléter
NEXT_PUBLIC_LEGAL_ADDRESS=À compléter
NEXT_PUBLIC_LEGAL_SIRET=À compléter
